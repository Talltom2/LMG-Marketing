# Walmart Marketplace API. Store production credentials only in deployment/local secrets.
WALMART_API_BASE_URL="https://marketplace.walmartapis.com"
WALMART_CLIENT_ID=""
WALMART_CLIENT_SECRET=""

# Pinterest API
PINTEREST_ACCESS_TOKEN=""

# TikTok diagnostics/integration. Keep real secrets only in Vercel/Codespaces secrets.
